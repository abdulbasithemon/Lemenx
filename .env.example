# Database — SQLite by default. For MySQL/PostgreSQL change the provider in
# prisma/schema.prisma and set the matching connection string here.
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT session cookies. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# WhatsApp provider: mock | twilio | meta
# "mock" logs messages to the console + whatsapp_logs table (no external call).
WHATSAPP_PROVIDER="mock"

# Twilio (WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Meta WhatsApp Business Cloud API (WHATSAPP_PROVIDER=meta)
META_WA_ACCESS_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
